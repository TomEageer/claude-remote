{
  "name": "claude-remote",
  "productName": "Claude 远程助手",
  "version": "1.9.5",
  "description": "通过 SSH 使用服务器上的 Claude Code 的桌面客户端",
  "main": "src/boot.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-main.js && node scripts/check-renderer.js",
    "predist:win": "sh scripts/build-vpn.sh && node scripts/check-main.js && node scripts/check-renderer.js",
    "predist:mac": "sh scripts/build-vpn.sh && node scripts/check-main.js && node scripts/check-renderer.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64",
    "make-update": "node scripts/make-update.js",
    "build:vpn": "sh scripts/build-vpn.sh"
  },
  "build": {
    "appId": "io.claude-remote.app",
    "productName": "Claude 远程助手",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/cpu-features/**",
      "!node_modules/ssh2/lib/protocol/crypto/build/**"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "build/afterPack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "vpn/dist/win-${arch}",
          "to": "bin"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Claude 远程助手",
      "artifactName": "ClaudeRemote-Setup.exe",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "runAfterFinish": true
    },
    "npmRebuild": false,
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "extraResources": [
        {
          "from": "vpn/dist/mac-${arch}",
          "to": "bin"
        }
      ]
    },
    "dmg": {
      "artifactName": "ClaudeRemote-${arch}.dmg",
      "format": "ULFO"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TomEageer",
        "repo": "claude-remote"
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "zh_CN",
      "en-US",
      "en"
    ]
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "marked": "^18.1.0",
    "ssh2": "^1.17.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "resedit": "^2.0.3"
  },
  "repository": "github:TomEageer/claude-remote"
}
